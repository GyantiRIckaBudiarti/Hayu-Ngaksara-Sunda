--- !u!114 &1773280256
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1773280253}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 922f6b42a2478b14ba7b02e9d0b2ee6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HayuNgaksara.NPCController
  npcName: Bu Guru
  npcTitle: 
  chapterOwned: 5
  portrait: {fileID: 21300000, guid: 632e992108e525a4cae72ceb9b01ed6c, type: 3}
  showNameLabel: 1
  labelOffsetY: 0.22
  labelFontSize: 0.18
  dialogLocked:
  - speakerName: Bu Guru
    text: Hei, kamu belum selesai belajar semua materi. Selesaikan dulu Aksara Swara,
      Ngalagena, dan Rarangken ya!
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  dialogIdle:
  - speakerName: Bu Guru
    text: "Wilujeng sumping di Rohangan R\xE9fl\xE9ksi!\n<size=68%><i><color=#C3BCAD>(Selamat
      datang di Ruang Refleksi!)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bu Guru
    text: 'Di dieu urang bakal nguji sabaraha jero pamahaman anjeun kana aksara nu
      geus diajar.

      <size=68%><i><color=#C3BCAD>(Di sini kita akan menguji
      seberapa jauh pemahamanmu tentang aksara yang sudah dipelajari.)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bu Guru
    text: "Anjeun tiasa ngapalkeun heula sakedap, atawa langsung ngamimitian R\xE9fl\xE9ksi.
      Siap?\n<size=68%><i><color=#C3BCAD>(Kamu bisa hafal dulu sejenak, atau langsung
      mulai Refleksi. Siap?)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  dialogPostComplete:
  - speakerName: Bu Guru
    text: Luar biasa! Kamu telah menyelesaikan Ujian Final Aksara Sunda!
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bu Guru
    text: Selamat! Kamu sudah mahir membaca dan menulis Aksara Sunda. Terus lestarikan
      budaya Sunda ya!
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  isSkillNPC: 1
  skillMode: 6
  isLevelUpNPC: 0
  choiceYes: Siap, Bu! Ayo mulai ujian!
  choiceNo: Belum siap. Saya belajar dulu ya.
  choiceRepeat: Ya, ayo ulangi lagi!
  choiceNoRepeat: Tidak, terima kasih.
  facePlayer: 1
  faceRadius: 2.5
