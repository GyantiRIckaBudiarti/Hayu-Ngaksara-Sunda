--- !u!114 &1298651490
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1298651488}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 922f6b42a2478b14ba7b02e9d0b2ee6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HayuNgaksara.NPCController
  npcName: Sinta
  npcTitle: Ibu
  chapterOwned: 1
  portrait: {fileID: 21300000, guid: 874701dc3c204da449125542951fa950, type: 3}
  showNameLabel: 1
  labelOffsetY: 0.5
  labelFontSize: 0.4
  dialogLocked:
  - speakerName: Sinta
    text: Kamu siapa? Belajar dulu Aksara Swara sama Jajang ya sebelum ngobrol sama
      aku!
    portrait: {fileID: 9131003857786023209, guid: 874701dc3c204da449125542951fa950, type: 3}
    autoAdvanceAfter: 0
  dialogIdle:
  - speakerName: Ibu Sinta
    text: "Wilujeng! Abdi Sinta. Abdi sp\xE9sialis MACA Aksara Sunda!\n<size=68%><i><color=#C3BCAD>(Hai!
      Aku Sinta. Aku spesialis MEMBACA Aksara Sunda!)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Ibu Sinta
    text: 'Urang bakal diajar wanoh kana bentuk unggal aksara jeung cara macana.

      <size=68%><i><color=#C3BCAD>(Kita
      akan belajar mengenali bentuk setiap aksara dan cara membacanya.)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Ibu Sinta
    text: 'Siap diajar maca babarengan jeung abdi?

      <size=68%><i><color=#C3BCAD>(Siap
      belajar membaca bersama aku?)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  dialogPostComplete:
  - speakerName: Sinta
    text: Wah kamu udah jago! Sekarang coba ke Nabila ya, buat belajar konsonan.
    portrait: {fileID: 9131003857786023209, guid: 874701dc3c204da449125542951fa950, type: 3}
    autoAdvanceAfter: 0
  isSkillNPC: 1
  skillMode: 3
  isLevelUpNPC: 0
  choiceYes: Oke, ayo kita mulai!
  choiceNo: Maaf, aku belum siap. Nanti ya.
  choiceRepeat: Ya, ayo ulangi lagi!
  choiceNoRepeat: Tidak, terima kasih.
  facePlayer: 1
  faceRadius: 2
