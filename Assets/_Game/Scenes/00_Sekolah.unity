--- !u!114 &1116803935
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1116803933}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 922f6b42a2478b14ba7b02e9d0b2ee6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HayuNgaksara.NPCController
  npcName: Andre
  npcTitle: Bapak
  chapterOwned: 4
  portrait: {fileID: 21300000, guid: 8135cce1916dbf9499aa09a99b520cd6, type: 3}
  showNameLabel: 1
  labelOffsetY: 0.22
  labelFontSize: 0.18
  dialogLocked:
  - speakerName: Andre
    text: Bro, kamu belum siap buat Rarangken. Selesaikan dulu Ngalagena!
    portrait: {fileID: -5883785045844372084, guid: 8135cce1916dbf9499aa09a99b520cd6, type: 3}
    autoAdvanceAfter: 0
  dialogIdle:
  - speakerName: Bapak Andre
    text: 'Halo! Abdi Andre. Anjeun geus apal aksarana?

      <size=68%><i><color=#C3BCAD>(Halo!
      Aku Andre. Kamu sudah hafal aksaranya?)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Andre
    text: "Ayeuna waktosna NGAGABUNGKEUN konsonan jeung rarangk\xE9n jadi suku kata!\n<size=68%><i><color=#C3BCAD>(Sekarang
      saatnya MENGGABUNGKAN konsonan dengan rarangken jadi suku kata!)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Andre
    text: "Kawas Ka + Panghulu = Ki. Kas\xE9p, san\xE9s? Hayu cobian!\n<size=68%><i><color=#C3BCAD>(Seperti
      Ka + Panghulu = Ki. Keren kan? Ayo coba!)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  dialogPostComplete:
  - speakerName: Andre
    text: Mantap! Sekarang lo udah siap buat Ujian Final. Temui Jajang!
    portrait: {fileID: -5883785045844372084, guid: 8135cce1916dbf9499aa09a99b520cd6, type: 3}
    autoAdvanceAfter: 0
  isSkillNPC: 1
  skillMode: 1
  isLevelUpNPC: 0
  choiceYes: Oke, ayo kita mulai!
  choiceNo: Maaf, aku belum siap. Nanti ya.
  choiceRepeat: Ya, ayo ulangi lagi!
  choiceNoRepeat: Tidak, terima kasih.
  facePlayer: 1
  faceRadius: 2
