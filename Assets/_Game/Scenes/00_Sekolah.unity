--- !u!114 &128327788
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 128327786}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 922f6b42a2478b14ba7b02e9d0b2ee6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HayuNgaksara.NPCController
  npcName: Jajang
  npcTitle: Bapak
  chapterOwned: 0
  portrait: {fileID: 21300000, guid: 549975d1c7a5495488fb4feddc7f6dff, type: 3}
  showNameLabel: 1
  labelOffsetY: 0.22
  labelFontSize: 0.18
  dialogLocked:
  - speakerName: Jajang
    text: Hei! Gue Jajang. Kamu baru ya di sekolah ini?
    portrait: {fileID: -3351759374321681350, guid: 549975d1c7a5495488fb4feddc7f6dff, type: 3}
    autoAdvanceAfter: 0
  - speakerName: Jajang
    text: Besok ada ujian Aksara Sunda! Kamu harus belajar ke Sinta, Nabila, Ucup,
      dan Andre.
    portrait: {fileID: -3351759374321681350, guid: 549975d1c7a5495488fb4feddc7f6dff, type: 3}
    autoAdvanceAfter: 0
  - speakerName: Jajang
    text: Temuin mereka di dalam sekolah. Pakai WASD buat jalan, E buat ngobrol!
    portrait: {fileID: -3351759374321681350, guid: 549975d1c7a5495488fb4feddc7f6dff, type: 3}
    autoAdvanceAfter: 0
  dialogIdle:
  - speakerName: Bapak Jajang
    text: "H\xE9y! Abdi Jajang. Wilujeng sumping di Sakola Aksara Sunda!\n<size=68%><i><color=#C3BCAD>(Hai!
      Aku Jajang. Selamat datang di Sekolah Aksara Sunda!)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Jajang
    text: 'Isukan aya ujian! Anjeun kudu diajar ti sadayana di dieu.

      <size=68%><i><color=#C3BCAD>(Besok
      ada ujian! Kamu harus belajar dari semua orang di sini.)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Jajang
    text: 'Panggih Ibu SINTA pikeun diajar MACA aksara Sunda.

      <size=68%><i><color=#C3BCAD>(Temui
      Ibu SINTA untuk belajar MEMBACA aksara Sunda.)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Jajang
    text: "Panggih Bapak UCUP pikeun latihan NULIS aksara \u2014 leungeun kudu apal
      bentukna!\n<size=68%><i><color=#C3BCAD>(Temui Bapak UCUP untuk latihan MENULIS
      aksara \u2014 tangan harus hafal bentuknya!)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Jajang
    text: 'Panggih Ibu NABILA pikeun latihan NGUCAPKEUN aksara kalayan bener.

      <size=68%><i><color=#C3BCAD>(Temui
      Ibu NABILA untuk latihan MELAFALKAN aksara dengan benar.)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Jajang
    text: "Sanggeus siap, panggih BU GURU pikeun R\xC9FL\xC9KSI jeung ujian.\n<size=68%><i><color=#C3BCAD>(Setelah
      siap, temui BU GURU untuk REFLEKSI dan ujian.)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Jajang
    text: "Pak\xE9 WASD pikeun leumpang, E pikeun interaksi. Hayu, sumanget!\n<size=68%><i><color=#C3BCAD>(Pakai
      WASD untuk jalan, E untuk interaksi. Ayo, semangat!)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  dialogPostComplete: []
  isSkillNPC: 0
  skillMode: 0
  isLevelUpNPC: 1
  choiceYes: Oke, ayo kita mulai!
  choiceNo: Maaf, aku belum siap. Nanti ya.
  choiceRepeat: Ya, ayo ulangi lagi!
  choiceNoRepeat: Tidak, terima kasih.
  facePlayer: 1
  faceRadius: 2
