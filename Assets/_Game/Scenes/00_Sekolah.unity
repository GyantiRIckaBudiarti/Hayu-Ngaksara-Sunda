--- !u!114 &338168414
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 338168412}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 922f6b42a2478b14ba7b02e9d0b2ee6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HayuNgaksara.NPCController
  npcName: Ucup
  npcTitle: Bapak
  chapterOwned: 3
  portrait: {fileID: 21300000, guid: 9eb34c348996275468edadcfffd97750, type: 3}
  showNameLabel: 1
  labelOffsetY: 0.22
  labelFontSize: 0.18
  dialogLocked:
  - speakerName: Ucup
    text: Bro, selesaiin dulu sama Nabila ya! Gue tunggu.
    portrait: {fileID: -5189490901778310874, guid: 9eb34c348996275468edadcfffd97750, type: 3}
    autoAdvanceAfter: 0
  dialogIdle:
  - speakerName: Bapak Ucup
    text: 'Halo! Abdi Ucup. Hoyong latihan NULIS aksara Sunda?

      <size=68%><i><color=#C3BCAD>(Halo!
      Aku Ucup. Mau latihan MENULIS aksara Sunda?)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Ucup
    text: "Diajar nulis t\xE9h penting \u2014 leungeun kudu apal bentukna, lain ngan
      panon!\n<size=68%><i><color=#C3BCAD>(Belajar menulis itu penting \u2014 tangan
      harus hafal bentuknya, bukan cuma mata!)</color></i></size>"
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Bapak Ucup
    text: 'Hayu, latihan nulis aksara babarengan!

      <size=68%><i><color=#C3BCAD>(Ayo,
      latihan menulis aksara bersama!)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  dialogPostComplete:
  - speakerName: Ucup
    text: Gokil! Lo udah hafal semua! Sekarang Andre nguajarin Rarangken.
    portrait: {fileID: -5189490901778310874, guid: 9eb34c348996275468edadcfffd97750, type: 3}
    autoAdvanceAfter: 0
  isSkillNPC: 1
  skillMode: 4
  isLevelUpNPC: 0
  choiceYes: Oke, ayo kita mulai!
  choiceNo: Maaf, aku belum siap. Nanti ya.
  choiceRepeat: Ya, ayo ulangi lagi!
  choiceNoRepeat: Tidak, terima kasih.
  facePlayer: 1
  faceRadius: 2
