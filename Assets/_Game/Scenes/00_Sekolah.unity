--- !u!114 &822701701
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 822701699}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 922f6b42a2478b14ba7b02e9d0b2ee6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HayuNgaksara.NPCController
  npcName: Nabila
  npcTitle: Ibu
  chapterOwned: 2
  portrait: {fileID: 21300000, guid: 21ef54d0477620e4ea787b28501902e9, type: 3}
  showNameLabel: 1
  labelOffsetY: 0.5
  labelFontSize: 0.4
  dialogLocked:
  - speakerName: Nabila
    text: Halo! Selesaikan dulu belajar Aksara Swara sama Sinta ya!
    portrait: {fileID: 4048095529440491108, guid: 21ef54d0477620e4ea787b28501902e9, type: 3}
    autoAdvanceAfter: 0
  dialogIdle:
  - speakerName: Ibu Nabila
    text: 'Wilujeng! Abdi Nabila. Abdi ahli NGUCAPKEUN Aksara Sunda.

      <size=68%><i><color=#C3BCAD>(Hai!
      Aku Nabila. Aku ahli PELAFALAN Aksara Sunda.)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Ibu Nabila
    text: 'Urang bakal latihan cara ngucapkeun unggal aksara kalayan bener.

      <size=68%><i><color=#C3BCAD>(Kita
      akan berlatih cara mengucapkan setiap aksara dengan benar.)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  - speakerName: Ibu Nabila
    text: 'Siap latihan ngucapkeun babarengan jeung abdi?

      <size=68%><i><color=#C3BCAD>(Siap
      latihan pelafalan bersama aku?)</color></i></size>'
    portrait: {fileID: 0}
    autoAdvanceAfter: 0
  dialogPostComplete:
  - speakerName: Nabila
    text: Bagus! Sekarang temui Ucup untuk belajar sisa konsonannya.
    portrait: {fileID: 4048095529440491108, guid: 21ef54d0477620e4ea787b28501902e9, type: 3}
    autoAdvanceAfter: 0
  isSkillNPC: 1
  skillMode: 5
  isLevelUpNPC: 0
  choiceYes: Oke, ayo kita mulai!
  choiceNo: Maaf, aku belum siap. Nanti ya.
  choiceRepeat: Ya, ayo ulangi lagi!
  choiceNoRepeat: Tidak, terima kasih.
  facePlayer: 1
  faceRadius: 2
